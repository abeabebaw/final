{
  "name": "crprs-backend",
  "version": "2.2.0",
  "description": "Cadastre and Real Property Registration System - Backend (PREN Stack)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "psql -U postgres -f db/schema.sql",
    "db:init:neon": "node db/init-neon.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:parcels": "node prisma/seed-parcels.js",
    "prisma:seed:applications": "node prisma/seed-applications.js",
    "prisma:seed:all": "npm run prisma:seed && npm run prisma:seed:parcels && npm run prisma:seed:applications",
    "prisma:studio": "prisma studio",
    "seed": "node db/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
