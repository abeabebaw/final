# ========================================================
# CRPRS System - Environment Configuration Example
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL with PostGIS)
# For local Docker:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crprs_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crprs_db?schema=public

# Neon Cloud Database (Alternative)
# DATABASE_URL=postgresql://user:pass@ep-example.neon.tech/crprs_db?sslmode=require

# Authentication & Security
JWT_SECRET=crprs_jwt_super_secret_enterprise_key_change_in_production
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=crprs_redis_secret

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=crprs-documents

# GeoServer (Spatial Services WMS/WFS)
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# Email Notifications (MailHog)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Document Uploads Directory (Local fallback)
UPLOAD_DIR=./uploads
